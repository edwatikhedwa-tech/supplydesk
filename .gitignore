cache/

__pycache__/
pycache/
*.py[cod]
.venv/
venv/
mail-data/
*.sqlite3
*.db

.vercel

# Единственное место для временных/рабочих файлов сессии — см. корневой CLAUDE.md
tmp/

.vercel
.env*
runtime/*.json
*.live-mail.lock
