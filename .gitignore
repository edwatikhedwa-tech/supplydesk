# Доступы к XMLRiver — в репозиторий не попадают
# `.env.example` remains ignored until the publish policy confirms a
# placeholder-only template and explicitly admits it.
.env*
.env.backup-*

# Выгрузки и рабочие данные: ignored by directory, not by generic extension.
# Project-owned JSON/CSV fixtures, manifests and configuration remain visible.
results/

# Скриншоты и визуальные QA-артефакты — не источник истины, не коммитим
artifacts/

# Кэш обкачанных страниц для benchmark_models.py — генерируется заново при
# каждом прогоне, не источник истины
cache/

__pycache__/
pycache/
*.py[cod]
.venv/
.venv-test/
venv/
mail-data/
*.sqlite3
*.db

.vercel

# Единственное место для временных/рабочих файлов сессии — см. корневой CLAUDE.md
tmp/

runtime/*.json
runtime/*.log
runtime/test-data/
*.live-mail.lock
