# Скопируйте этот файл в .env и подставьте свои значения.
# Доступы берутся в личном кабинете: https://xmlriver.com/account/
XMLRIVER_USER=
XMLRIVER_KEY=
# Глубина поиска Яндекса в страницах выдачи (SerpCollector.pages). По
# умолчанию 1 — узкая воронка; поднимайте для более глубокого прогона.
SERP_PAGES=1
# Правило с 24.08.2026: всё, что нашёл SERP (после дедупликации по домену и
# стоп-листа), обрабатывается — без тихого обрезания. Пусто/не задано = без
# потолка. Задайте число, только если сознательно хотите ограничить
# стоимость/время конкретного прогона.
SERP_RESULTS_PER_POSITION=

# Подтверждение ИНН в реестре. Бесплатно 10 000 запросов в день: https://dadata.ru/
DADATA_TOKEN=

# Нужен только для ступени --llm в collect_inn.py
ANTHROPIC_API_KEY=

# LLM-ступень через RouterAI: вызывается только для сайтов, которые не разобрались
# регулярками, внутри веб-поиска заявок (supplier_app.py._enrich_suppliers). Модель
# по умолчанию — google/gemini-2.5-flash-lite, см. docs/enrichment-and-cache.md.
ROUTERAI_KEY=
# Дневной потолок расхода на LLM-ступень в рублях. При исчерпании ступень
# отключается сама — поиск продолжает работать на бесплатных регулярках.
LLM_DAILY_BUDGET_RUB=50
# Реестр ЕГРЮЛ/ЕГРИП по ИНН: название, статус, ОКВЭД, контакты, риски,
# финансовая отчётность. Можно указать несколько ключей (CHECKO_KEY_2,
# CHECKO_KEY_3, ...) — при исчерпании дневного лимита одного ключа клиент
# сам переходит на следующий.
CHECKO_KEY=
CHECKO_KEY_2=

# Supplydesk local/backend settings
APP_HOST=127.0.0.1
APP_BASE_URL=http://127.0.0.1:8000
PORT=8000
APP_USER_EMAIL=
APP_USER_PASSWORD=
MAIL_DB_PATH=mail-data/supplier.sqlite3
# Production on Vercel: use the Neon/Postgres connection string provisioned by Vercel.
DATABASE_URL=
MAIL_TOKEN_ENCRYPTION_KEY=
MAIL_QUEUE_CONCURRENCY=1
MAIL_MAX_RETRIES=4
MAIL_DAILY_RECIPIENT_LIMIT=250

# Create an OAuth application at https://oauth.yandex.ru/
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8000/oauth/yandex/callback
YANDEX_OAUTH_SCOPE=mail:smtp mail:imap_full login:email
