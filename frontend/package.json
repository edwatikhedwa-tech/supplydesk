{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/run_frontend_dev.mjs",
    "build": "node ../scripts/run_frontend_dev.mjs --command build",
    "lint": "eslint .",
    "preview": "node ../scripts/run_frontend_dev.mjs --command preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node ../scripts/run_playwright.mjs --purpose AUTOMATED_TEST",
    "test:visual": "node ../scripts/run_playwright.mjs --purpose VISUAL_ACCEPTANCE tests/frontend-audit.spec.ts",
    "test:visual:eyes": "node ../scripts/run_playwright.mjs --purpose VISUAL_ACCEPTANCE --config playwright.applitools.config.ts",
    "test:storybook-visual": "node ../scripts/run_playwright.mjs --purpose AUTOMATED_TEST --config playwright.storybook.config.ts",
    "storybook": "node ../scripts/run_storybook.mjs",
    "build-storybook": "node ../scripts/run_storybook.mjs --command build",
    "knip": "knip",
    "lhci": "node ../scripts/run_lhci.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@applitools/eyes-playwright": "1.48.4",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.9.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "knip": "^6.34.0",
    "postcss": "^8.4.35",
    "storybook": "^8.6.15",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
