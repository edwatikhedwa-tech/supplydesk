{
  "documentation_control": [
    "^ai/",
    "^docs/",
    "^(AGENTS|CLAUDE)\\.md$",
    "^PROJECT_MANIFEST\\.yaml$",
    "^README\\.md$"
  ],
  "backend": [
    "^api/",
    "^mail/",
    "^supplier_discovery_v2/",
    "^supplier_app\\.py$",
    "^[^/]+\\.py$",
    "^tests/(?!diagnostics/)"
  ],
  "frontend": [
    "^frontend/"
  ],
  "browser": [
    "^frontend/src/",
    "^frontend/tests/",
    "^frontend/playwright[^/]*\\.(ts|js)$",
    "^frontend/lighthouserc\\.[^/]+$",
    "^scripts/run_(playwright|lhci|storybook)\\.mjs$"
  ],
  "mail": [
    "^mail/",
    "^tests/test_mail",
    "^tests/test_outgoing_safety\\.py$"
  ],
  "auth": [
    "^api/",
    "^supplier_app\\.py$",
    "^mail/auth\\.py$"
  ],
  "database": [
    "^migrations/",
    "^mail/(repository|runtime|service)\\.py$",
    "^tests/test_(canonical_runtime|mail_integrity|mail_integration)\\.py$"
  ],
  "api_shared_runtime": [
    "^api/",
    "^supplier_app\\.py$",
    "^scripts/(assert_workspace|bootstrap_supplydesk|doctor|recover_supplydesk|setup_test_env|start_local_canonical|start_test_runtime|stop_test_runtime)\\.ps1$",
    "^scripts/runtime_guard\\.py$",
    "^scripts/test_runtime_entry\\.py$",
    "^scripts/run_(frontend_dev|playwright|lhci|storybook)\\.mjs$",
    "^tests/run-tests\\.ps1$"
  ],
  "security": [
    "^\\.github/",
    "^scripts/ci/",
    "^\\.gitignore$",
    "^tests/test_outgoing_safety\\.py$",
    "^vercel\\.json$"
  ],
  "ci": [
    "^\\.github/",
    "^scripts/ci/"
  ],
  "dependency": [
    "^requirements[^/]*\\.txt$",
    "^frontend/package(-lock)?\\.json$"
  ],
  "control": [
    "^ai/",
    "^docs/",
    "^tests/diagnostics/",
    "^tests/run-tests\\.ps1$",
    "^scripts/(assert_workspace|bootstrap_supplydesk|doctor|recover_supplydesk|setup_test_env|start_local_canonical|start_test_runtime|stop_test_runtime)\\.ps1$",
    "^scripts/runtime_guard\\.py$",
    "^scripts/test_runtime_entry\\.py$",
    "^scripts/run_(frontend_dev|playwright|lhci|storybook)\\.mjs$",
    "^scripts/(start_server_and_open|start_server)\\.(ps1|bat)$",
    "^scripts/ci/",
    "^(AGENTS|CLAUDE)\\.md$",
    "^PROJECT_MANIFEST\\.yaml$",
    "^\\.github/"
  ],
  "high_risk": [
    "^mail/",
    "^tests/test_mail",
    "^tests/test_outgoing_safety\\.py$",
    "^api/",
    "^supplier_app\\.py$",
    "^migrations/",
    "^scripts/(assert_workspace|bootstrap_supplydesk|doctor|recover_supplydesk|setup_test_env|start_local_canonical|start_test_runtime|stop_test_runtime)\\.ps1$",
    "^scripts/runtime_guard\\.py$",
    "^scripts/test_runtime_entry\\.py$",
    "^tests/run-tests\\.ps1$",
    "^scripts/diagnostics/",
    "^\\.github/",
    "^scripts/ci/",
    "^requirements[^/]*\\.txt$",
    "^frontend/package(-lock)?\\.json$",
    "^vercel\\.json$"
  ]
}
